
        <RSLogix5000Content TargetType="Program" TargetName="Drive">
          <Controller Use="Context" Name="PLC">
            <Programs Use="Context">
              <Program Use="Target" Name="Drive">
                <Tags>
                  <Tag Name="Instance" TagType="Base" DataType="Dvc_AOI"/>
                  <Tag Name="Cmd" TagType="Base" DataType="BOOL"/>
                </Tags>
                <Routines>
                  <Routine Name="Main" Type="RLL">
                    <RLLContent>
                      <Rung Number="3" Type="N">
                        <Text><![CDATA[
                          Dvc_AOI(Instance,DriveModule:I.Data,Cmd);
                        ]]></Text>
                      </Rung>
                    </RLLContent>
                  </Routine>
                </Routines>
              </Program>
            </Programs>
          </Controller>
        </RSLogix5000Content>
        