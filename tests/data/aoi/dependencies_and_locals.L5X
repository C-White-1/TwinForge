<?xml version="1.0" encoding="UTF-8"?>
<RSLogix5000Content TargetName="AOIContext" TargetType="Program">
  <Controller Use="Context" Name="TestController">
    <DataTypes>
      <DataType Name="ExampleData" Family="NoFamily" Class="User">
        <Members>
          <Member Name="Value" DataType="DINT" Dimension="0"
           Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"/>
        </Members>
      </DataType>
    </DataTypes>
    <Modules>
      <Module Use="Reference" Name="Local" ParentModule="Local"/>
    </Modules>
    <AddOnInstructionDefinitions>
      <AddOnInstructionDefinition Name="Helper" Revision="1.0"
       ExecutePrescan="false" ExecutePostscan="false"
       ExecuteEnableInFalse="false">
        <Parameters/>
        <LocalTags/>
        <Routines/>
      </AddOnInstructionDefinition>
      <AddOnInstructionDefinition Name="MainAOI" Revision="1.0"
       ExecutePrescan="false" ExecutePostscan="false"
       ExecuteEnableInFalse="false">
        <Parameters>
          <Parameter Name="Config" DataType="ExampleData" Usage="Input"
           Required="true" Visible="true">
            <DefaultData Format="Decorated">
              <Structure DataType="ExampleData">
                <DataValueMember Name="Value" DataType="DINT" Value="7"/>
              </Structure>
            </DefaultData>
          </Parameter>
          <Parameter Name="Status" TagType="Alias" Usage="Output"
           AliasFor="State.0" Required="false" Visible="true"/>
          <Parameter Name="ConfigValue" TagType="Alias" Usage="Output"
           AliasFor="Config.Value" Required="false" Visible="true"/>
          <Parameter Name="HistoryValue" TagType="Alias" Usage="Output"
           AliasFor="History[1].Value" Required="false" Visible="true"/>
        </Parameters>
        <LocalTags>
          <LocalTag Name="ConfigState" DataType="ExampleData"
           ExternalAccess="None">
            <DefaultData Format="Decorated">
              <Structure DataType="ExampleData">
                <DataValueMember Name="Value" DataType="DINT" Value="9"/>
              </Structure>
            </DefaultData>
          </LocalTag>
          <LocalTag Name="History" DataType="ExampleData" Dimensions="2"
           ExternalAccess="None"/>
          <LocalTag Name="State" DataType="DINT" Radix="Decimal"
           ExternalAccess="None">
            <DefaultData Format="Decorated">
              <DataValue DataType="DINT" Value="0"/>
            </DefaultData>
          </LocalTag>
        </LocalTags>
        <Routines>
          <Routine Name="Logic" Type="ST">
            <STContent>
              <Line Number="0"><![CDATA[State := State + 1;]]></Line>
            </STContent>
          </Routine>
        </Routines>
        <Dependencies>
          <Dependency Type="DataType" Name="ExampleData"/>
          <Dependency Type="AddOnInstructionDefinition" Name="Helper"/>
        </Dependencies>
      </AddOnInstructionDefinition>
    </AddOnInstructionDefinitions>
  </Controller>
</RSLogix5000Content>
