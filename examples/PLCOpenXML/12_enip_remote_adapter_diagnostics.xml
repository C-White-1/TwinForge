              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">xObservedEnabled := Dev_PF525.Enable;
xObservedDiagnosticAvailable := Dev_PF525.xDiagnosticAvailable;
sObservedDiagnostic := Dev_PF525.sDiagString;
eObservedDeviceState := Dev_PF525.GetDeviceState();

xInp_CanReconfigure :=
    DED.CanReconfigure(itfNode := Dev_PF525);
    
xInp_Connected :=
    (Dev_PF525.eState = IoDrvEtherNetIP.AdapterState.RUNNING)
    AND
    (eObservedDeviceState = DED.DEVICE_STATE.RUNNING);

xInp_Enabled := Dev_PF525.Enable;

xInp_Faulted :=
    (Dev_PF525.eState = IoDrvEtherNetIP.AdapterState.BUS_ERROR)
    OR
	(Dev_PF525.eState = IoDrvEtherNetIP.AdapterState.ERROR)
    OR
    (eObservedDeviceState = DED.DEVICE_STATE.ERROR);

xInp_DiagnosticAvailable :=
    Dev_PF525.xDiagnosticAvailable;
	
xInp_ReconfigureBusy :=
    fbReconfigure.xBusy;

xInp_ReconfigureDone :=
    fbReconfigure.xDone;

xInp_ReconfigureFailed :=
    fbReconfigure.xError;

eObservedReconfigureError :=
    fbReconfigure.eError;

fbModuleBinding(
    Inp_Connected := xInp_Connected,
    Inp_Enabled := xInp_Enabled,
    Inp_Faulted := xInp_Faulted,
    Inp_DiagnosticAvailable := xInp_DiagnosticAvailable,
    Inp_CanReconfigure := xInp_CanReconfigure,
    Inp_ReconfigureBusy := xInp_ReconfigureBusy,
    Inp_ReconfigureDone := xInp_ReconfigureDone,
    Inp_ReconfigureFailed := xInp_ReconfigureFailed,
    Inp_Inhibit := xInp_Inhibit,
    Inp_Uninhibit := xInp_Uninhibit,
    Out_Connected =&gt; xOut_Connected,
    Out_Enabled =&gt; xOut_Enabled,
    Out_Faulted =&gt; xOut_Faulted,
    Out_DiagnosticAvailable =&gt; xOut_DiagnosticAvailable,
    Out_RequestReconfigure =&gt; xOut_RequestReconfigure,
    Out_RequestedEnable =&gt; xOut_RequestedEnable,
    Out_ReconfigureBlocked =&gt; xOut_ReconfigureBlocked,
    Out_ReconfigureBusy =&gt; xOut_ReconfigureBusy,
    Out_ReconfigureDone =&gt; xOut_ReconfigureDone,
    Out_ReconfigureFailed =&gt; xOut_ReconfigureFailed
);

IF xOut_RequestReconfigure THEN
    Dev_PF525.Enable := xOut_RequestedEnable;
END_IF;

fbReconfigure(
    xExecute := xOut_RequestReconfigure,
    itfNode := Dev_PF525
);

</xhtml>
                </ST>
