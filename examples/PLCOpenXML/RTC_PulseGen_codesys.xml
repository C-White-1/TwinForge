          <data name="http://www.3s-software.com/plcopenxml/pou" handleUnknown="implementation">
            <pou name="RTC_PulseGen" pouType="functionBlock">
              <interface>
                <inputVars>
                  <variable name="EnableIn">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                  <variable name="Inp_Enable">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                  <variable name="Inp_Interval">
                    <type>
                      <DINT />
                    </type>
                  </variable>
                </inputVars>
                <outputVars>
                  <variable name="EnableOut">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                  <variable name="Sts_Enabled">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                  <variable name="Out">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                </outputVars>
                <localVars>
                  <variable name="OSR">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                  <variable name="TStart">
                    <type>
                      <LINT />
                    </type>
                  </variable>
                  <variable name="TNow">
                    <type>
                      <LINT />
                    </type>
                  </variable>
                  <variable name="tfWallClockMilliseconds">
                    <type>
                      <derived name="SysTime" />
                    </type>
                  </variable>
                  <variable name="tfWallClockResult">
                    <type>
                      <derived name="SysTypes.RTS_IEC_RESULT" />
                    </type>
                  </variable>
                </localVars>
              </interface>
              <body>
                <ST>
                  <html:xhtml>EnableOut := EnableIn;
IF EnableIn THEN
    tfWallClockResult := SysTimeRtcHighResGet(tfWallClockMilliseconds);
    IF tfWallClockResult = 0 THEN
        TNow := ULINT_TO_LINT(tfWallClockMilliseconds * ULINT#1000);
    END_IF;
    IF (tfWallClockResult = 0) THEN
        IF ((Inp_Enable AND NOT (OSR)) OR Out) THEN
            TStart := TNow;
        END_IF;
        OSR := Inp_Enable;
        Sts_Enabled := Inp_Enable;
        Out := (Inp_Enable AND ((TNow - TStart) &gt;= (Inp_Interval * 1000)));
    ELSE
        Sts_Enabled := FALSE;
        Out := FALSE;
    END_IF;
END_IF;</html:xhtml>
                </ST>
              </body>
              <addData>
