                  <html:xhtml>fbRTC_PulseGen(
    EnableIn := xEnableIn,
    EnableOut =&gt; xEnableOut,
    Inp_Enable := xInp_Enable,
    Inp_Interval := diInp_Interval,
    Sts_Enabled =&gt; xSts_Enabled,
    Out =&gt; xOut
);</html:xhtml>
                </ST>
              </body>
              <addData>
                <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
