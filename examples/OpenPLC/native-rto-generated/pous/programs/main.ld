            "numericId": "2833007",
            "variant": {
              "name": "TF_RTO",
              "type": "function-block",
              "language": "st",
              "variables": [
                {
                  "name": "IN",
                  "class": "input",
                  "type": {
                    "definition": "base-type",
                    "value": "BOOL"
                  }
                },
                {
                  "name": "RESET",
                  "class": "input",
                  "type": {
                    "definition": "base-type",
                    "value": "BOOL"
                  }
                },
                {
                  "name": "PT",
                  "class": "input",
                  "type": {
                    "definition": "base-type",
                    "value": "TIME"
                  }
                },
                {
                  "name": "Q",
                  "class": "output",
                  "type": {
                    "definition": "base-type",
                    "value": "BOOL"
                  }
                },
                {
                  "name": "ET",
                  "class": "output",
                  "type": {
                    "definition": "base-type",
                    "value": "TIME"
                  }
                },
                {
                  "name": "Enabled",
                  "class": "output",
                  "type": {
                    "definition": "base-type",
                    "value": "BOOL"
                  }
                },
                {
                  "name": "TT",
                  "class": "output",
                  "type": {
                    "definition": "base-type",
                    "value": "BOOL"
                  }
                }
              ],
              "body": "Enabled := IN;\n\nIF RESET THEN\n    SegmentTimer(IN := FALSE, PT := T#0s);\n    RetainedTime := T#0s;\n    RemainingTime := T#0s;\n    ET := T#0s;\n    Q := FALSE;\n    Enabled := FALSE;\n    TT := FALSE;\n    WasEnabled := FALSE;\nELSIF IN AND NOT Q THEN\n    IF RetainedTime >= PT THEN\n        RetainedTime := PT;\n        ET := PT;\n        Q := TRUE;\n        TT := FALSE;\n        SegmentTimer(IN := FALSE, PT := T#0s);\n    ELSE\n        RemainingTime := PT - RetainedTime;\n        SegmentTimer(IN := TRUE, PT := RemainingTime);\n        ET := RetainedTime + SegmentTimer.ET;\n        IF SegmentTimer.Q THEN\n            RetainedTime := PT;\n            ET := PT;\n            Q := TRUE;\n        END_IF;\n        TT := NOT Q;\n    END_IF;\nELSIF NOT IN THEN\n    IF WasEnabled AND NOT Q THEN\n        RetainedTime := RetainedTime + SegmentTimer.ET;\n        IF RetainedTime >= PT THEN\n            RetainedTime := PT;\n            Q := TRUE;\n        END_IF;\n    END_IF;\n    SegmentTimer(IN := FALSE, PT := T#0s);\n    ET := RetainedTime;\n    TT := FALSE;\nELSE\n    SegmentTimer(IN := FALSE, PT := T#0s);\n    ET := RetainedTime;\n    TT := FALSE;\nEND_IF;\n\nWasEnabled := IN;",
              "documentation": "TwinForge Rockwell-compatible retentive timer"
            },
