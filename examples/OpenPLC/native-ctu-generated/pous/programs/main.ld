                {
                  "name": "OV",
                  "class": "output",
                  "type": {
                    "definition": "base-type",
                    "value": "BOOL"
                  }
                }
              ],
              "body": "CountEnabled := CU;\n\nIF RESET THEN\n    CV := 0;\n    Q := FALSE;\n    OV := FALSE;\n    CountEnabled := FALSE;\n    WasCU := FALSE;\nELSE\n    IF CU AND NOT WasCU THEN\n        IF CV = 2147483647 THEN\n            CV := -2147483647 - 1;\n            OV := TRUE;\n        ELSE\n            CV := CV + 1;\n        END_IF;\n        IF CV >= PV THEN\n            Q := TRUE;\n        END_IF;\n    END_IF;\n    WasCU := CU;\nEND_IF;",
              "documentation": "TwinForge Rockwell-compatible count-up counter"
            },
