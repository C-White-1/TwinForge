    Out_JogRev =&gt; xOut_JogRev,
    Out_Starting =&gt; xOut_Starting,
    Out_Stopping =&gt; xOut_Stopping
);

fbModuleBinding(
    Inp_Connected := xInp_Connected,
    Inp_Enabled := xInp_Enabled,
    Inp_Faulted := xInp_Faulted,
    Inp_DiagnosticAvailable := xInp_DiagnosticAvailable,
