    Out_ReconfigureBusy =&gt; xOut_ReconfigureBusy,
    Out_ReconfigureDone =&gt; xOut_ReconfigureDone,
    Out_ReconfigureFailed =&gt; xOut_ReconfigureFailed
);

IF xOut_RequestReconfigure THEN
    Dev_PF525.Enable := xOut_RequestedEnable;
END_IF;

fbReconfigure(
    xExecute := xOut_RequestReconfigure,
    itfNode := Dev_PF525
);</Single>
