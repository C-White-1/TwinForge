    Inp_StartDelayMs := diInp_StartDelayMs,
    Inp_ElapsedMs := diInp_ElapsedMs,
    Out_LogicCommand =&gt; uiOut_LogicCommand,
    Out_SpeedCommand =&gt; iOut_SpeedCommand,
    Out_RefSpeed =&gt; rOut_RefSpeed,
    Out_PermOK =&gt; xOut_PermOK,
    Out_IntlkOK =&gt; xOut_IntlkOK,
    Out_RunFwd =&gt; xOut_RunFwd,
    Out_RunRev =&gt; xOut_RunRev,
