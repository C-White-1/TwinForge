            <Single Name="TextBlobForSerialisation" Type="string">xObservedEnabled := Dev_PF525.Enable;
xObservedDiagnosticAvailable := Dev_PF525.xDiagnosticAvailable;
sObservedDiagnostic := Dev_PF525.sDiagString;
eObservedDeviceState := Dev_PF525.GetDeviceState();

xInp_CanReconfigure := DED.CanReconfigure(
    itfNode := Dev_PF525
);

xInp_Connected :=
    (Dev_PF525.eState = IoDrvEtherNetIP.AdapterState.RUNNING)
    AND
    (eObservedDeviceState = DED.DEVICE_STATE.RUNNING);
xInp_Enabled := Dev_PF525.Enable;
xInp_Faulted :=
    (Dev_PF525.eState = IoDrvEtherNetIP.AdapterState.BUS_ERROR)
    OR
    (Dev_PF525.eState = IoDrvEtherNetIP.AdapterState.ERROR)
    OR
    (eObservedDeviceState = DED.DEVICE_STATE.ERROR);
xInp_DiagnosticAvailable := Dev_PF525.xDiagnosticAvailable;
xInp_ReconfigureBusy := fbReconfigure.xBusy;
xInp_ReconfigureDone := fbReconfigure.xDone;
xInp_ReconfigureFailed := fbReconfigure.xError;
eObservedReconfigureError := fbReconfigure.eError;

fbPowerFlex525(
    Inp_Source := diInp_Source,
    Inp_PRunFwd := xInp_PRunFwd,
    Inp_PRunRev := xInp_PRunRev,
    Inp_PJogFwd := xInp_PJogFwd,
    Inp_PJogRev := xInp_PJogRev,
    Inp_PStop := xInp_PStop,
    Inp_PReset := xInp_PReset,
    Inp_PSpeed := rInp_PSpeed,
    Inp_ORunFwd := xInp_ORunFwd,
    Inp_ORunRev := xInp_ORunRev,
    Inp_OJogFwd := xInp_OJogFwd,
    Inp_OJogRev := xInp_OJogRev,
    Inp_OStop := xInp_OStop,
    Inp_OReset := xInp_OReset,
    Inp_OSpeed := rInp_OSpeed,
    Inp_XRunFwd := xInp_XRunFwd,
    Inp_XRunRev := xInp_XRunRev,
    Inp_XJogFwd := xInp_XJogFwd,
    Inp_XJogRev := xInp_XJogRev,
    Inp_XStop := xInp_XStop,
    Inp_XReset := xInp_XReset,
    Inp_XSpeed := rInp_XSpeed,
    Inp_MRunFwd := xInp_MRunFwd,
    Inp_MRunRev := xInp_MRunRev,
    Inp_MJogFwd := xInp_MJogFwd,
    Inp_MJogRev := xInp_MJogRev,
    Inp_MStop := xInp_MStop,
    Inp_MReset := xInp_MReset,
    Inp_MSpeed := rInp_MSpeed,
    Inp_OvCmd := diInp_OvCmd,
    Inp_OvSpeed := rInp_OvSpeed,
    Inp_PSetOverride := xInp_PSetOverride,
    Inp_MPSet := rInp_MPSet,
    Inp_PermOK := xInp_PermOK,
    Inp_NBPermOK := xInp_NBPermOK,
    Inp_IntlkOK := xInp_IntlkOK,
    Inp_NBIntlkOK := xInp_NBIntlkOK,
    Inp_Bypass := xInp_Bypass,
    Inp_RunFwdAvail := xInp_RunFwdAvail,
    Inp_RunRevAvail := xInp_RunRevAvail,
    Inp_JogFwdAvail := xInp_JogFwdAvail,
    Inp_JogRevAvail := xInp_JogRevAvail,
    Inp_Ready := xInp_Ready,
    Inp_Active := xInp_Active,
